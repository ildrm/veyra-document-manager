{
  "name": "@veyra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veyra evidence-first document intelligence API",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --import tsx src/database/migrate.ts",
    "db:seed": "node --import tsx src/database/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
